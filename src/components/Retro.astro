---
// Back cover: who we are and how to give.
import { EMAIL, INSTAGRAM, IBAN } from '../lib/edizioni';
interface Props {
  dono?: boolean;
}
const { dono = true } = Astro.props;
---
<footer class="retro ink">
  <div class="wrap griglia">
    <img src="/logo-300.webp" width="300" height="300" alt="" loading="lazy" decoding="async" />
    <div class="testo">
      <p class="nome">Con Giovanni ODV</p>
      <p>Organizzazione di volontariato fondata a Livorno il 4 novembre 2024 dalla famiglia e dagli amici di Giovanni Capanna.</p>
      <ul>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li><a href={INSTAGRAM} rel="me">Instagram @con_giovanni</a></li>
      </ul>
    </div>
    {dono && (
      <div class="dono">
        <h2>Sostieni il Premio</h2>
        <p>Bonifico intestato a Con Giovanni ODV</p>
        <p class="iban num" id="iban-retro">{IBAN}</p>
        <button class="btn" type="button" data-copia={IBAN} aria-controls="iban-retro">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="8" y="8" width="12" height="12" /><path d="M16 8V4H4v12h4" /></svg>
          <span data-etichetta aria-live="polite">Copia IBAN</span>
        </button>
      </div>
    )}
  </div>
</footer>

<style>
  .retro { padding-block: var(--space-5) var(--space-4); }
  .griglia {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-4) clamp(1.5rem, 4vw, 3.5rem);
  }
  img { width: clamp(6rem, 14vw, 9.5rem); margin-top: -0.5rem; }
  .nome {
    font-weight: 800;
    font-stretch: 72%;
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3.25rem);
    line-height: 0.95;
    margin-bottom: 0.9rem;
  }
  .testo > p:not(.nome) { max-width: 34rem; color: var(--paper-2); }
  ul { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.15rem; }
  li a { display: inline-flex; align-items: center; min-height: 2.75rem; overflow-wrap: anywhere; }

  .dono {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    min-width: 19rem;
    padding: var(--space-3);
    border: 1.5px solid var(--paper);
  }
  .dono h2 {
    font-size: 1.5rem;
    font-stretch: 75%;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .dono p:not(.iban) { color: var(--paper-2); }
  .iban {
    font-weight: 650;
    font-stretch: 85%;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .dono .btn { margin-top: 0.4rem; }

  @media (max-width: 64rem) {
    .griglia { grid-template-columns: auto minmax(0, 1fr); }
    .dono { grid-column: 2; min-width: 0; }
  }
  @media (max-width: 34rem) {
    .griglia { grid-template-columns: 1fr; }
    .dono { grid-column: 1; }
  }
</style>
