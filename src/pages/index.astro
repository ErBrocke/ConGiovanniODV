---
import Base from '../layouts/Base.astro';
import Testata from '../components/Testata.astro';
import Biglietto from '../components/Biglietto.astro';
import Scaletta from '../components/Scaletta.astro';
import Testatina from '../components/Testatina.astro';
import Folio from '../components/Folio.astro';
import {
  tutteLeEdizioni,
  inCopertina,
  romano,
  dataLunga,
  dataBreve,
  ora,
  anno,
  isoGiorno,
} from '../lib/edizioni';
import { eventoSchema } from '../lib/schema';

const edizioni = await tutteLeEdizioni();
const { edizione: cop, futura } = inCopertina(edizioni);
const daAnnunciare = futura && (!cop.data.ora || cop.data.premiati.length === 0);
// Last year's real running order shows what the evening is.
const esempio = edizioni.find((e) => e.data.programma.length > 0);
const site = Astro.site ?? new URL('https://congiovanniodv.pages.dev');
const sommario = [
  { href: '/giovanni/', titolo: 'A Giovanni', testo: 'Chi era, con le foto di famiglia.', pagina: 5 },
  { href: '/premio/', titolo: 'Il Premio', testo: 'Come nasce e tutte le edizioni, con i premiati.', pagina: 6 },
  { href: '/sostieni/', titolo: 'Come sostenerci', testo: 'Bonifico, aiuto, e dove seguirci.', pagina: 7 },
];
---
<Base
  title="Con Giovanni ODV · Associazione in ricordo di Giovanni Capanna, Livorno"
  description={`Con Giovanni ODV ricorda Giovanni Capanna: ricerca sul tumore al pancreas metastatico, sostegno agli artisti, impegno della comunità e il Premio Giovanni Capanna. Prossimo Premio: ${dataLunga(cop.data.data).toLowerCase()}, Auditorium del Conservatorio Mascagni, ingresso libero.`}
  jsonLd={[eventoSchema(cop, site)]}
  dono={false}
>
  <!-- Copertina: this year's programme. -->
  <div class="ink copertina">
    <div class="wrap copertina-wrap">
      <Testata />

      <div class="frontespizio">
        <h1 id="titolo">
          <span>Con</span>
          <span>Giovanni</span>
          <span>ODV</span>
        </h1>
        <img
          class="logo"
          src="/logo-500.webp"
          width="500"
          height="500"
          alt="Logo di Con Giovanni ODV: Giovanni con gli occhiali da sole dentro un cerchio blu"
          fetchpriority="high"
        />
      </div>

      <div class="locandina">
        <div class="dati">
          <p class="quando">
            <time datetime={isoGiorno(cop.data.data)}>{dataLunga(cop.data.data)}</time>{ora(cop) && <>, {ora(cop)}</>}
          </p>
          <p class="dove">Auditorium del Conservatorio Mascagni, Livorno</p>
          <p class="typed nota">
            {romano(cop.data.numero)} Premio Giovanni Capanna · ingresso libero{daAnnunciare && <> · orario e premiati saranno annunciati qui</>}
          </p>
        </div>
        <div class="azioni">
          {futura ? <Biglietto edizione={cop} /> : <a class="btn" href={`/premio/${anno(cop)}/`}>Com’è andata la {romano(cop.data.numero)} edizione</a>}
          <a class="link-sostieni" href="/sostieni/">Sostieni il Premio</a>
        </div>
      </div>
    </div>
  </div>

  <main id="contenuto">
    <!-- L'associazione: what Con Giovanni ODV is for. -->
    <section class="pagina associazione" aria-labelledby="assoc-t">
      <div class="wrap"><Testatina numero={cop.data.numero} /></div>
      <div class="wrap due">
        <div class="intro">
          <h2 id="assoc-t" class="display">L’associazione</h2>
          <p class="lead">In ricordo di Giovanni, l’associazione è dedicata a promuovere la ricerca sul tumore al pancreas metastatico e a celebrare l’eccellenza nelle arti, sostenendo artisti e attori, favorendo l’impegno della comunità e creando un impatto duraturo.</p>
        </div>
        <dl class="attivita">
          <div class="voce-attivita">
            <dt>Premio annuale</dt>
            <dd>Ogni anno il Premio Giovanni Capanna va a giovani artisti livornesi di musica e teatro. <a href="/premio/">Il Premio e le edizioni</a></dd>
          </div>
          <div class="voce-attivita">
            <dt>Supporto artistico</dt>
            <dd>Sostegno ad artisti e attori, e attenzione allo studio e alle attività culturali.</dd>
          </div>
          <div class="voce-attivita">
            <dt>Coinvolgimento della comunità</dt>
            <dd>Iniziative di solidarietà e impegno condiviso, per un impatto che duri. <a href="/sostieni/">Dai una mano</a></dd>
          </div>
          <div class="voce-attivita">
            <dt>Ricerca medica</dt>
            <dd>Promuove la ricerca sul tumore al pancreas metastatico.</dd>
          </div>
        </dl>
      </div>
      <div class="wrap"><Folio n={2} /></div>
    </section>

    <!-- La serata: a real running order, not a promise. -->
    {esempio && (
      <section class="pagina serata" aria-labelledby="serata-t">
        <div class="wrap"><Testatina numero={cop.data.numero} /></div>
        <div class="wrap due">
          <div class="intro">
            <h2 id="serata-t" class="display">Una serata di musica e teatro</h2>
            <p class="lead">Il Premio si consegna sul palco dell’Auditorium del Conservatorio Mascagni, davanti a chiunque voglia esserci. I premiati non ritirano soltanto: suonano e recitano.</p>
            <p><a href={`/premio/${anno(esempio)}/`}>La {romano(esempio.data.numero)} edizione, per intero</a></p>
          </div>
          <div class="programma">
            <Scaletta programma={esempio.data.programma} />
            <p class="typed didascalia">
              Programma della {romano(esempio.data.numero)} edizione, {dataBreve(esempio.data.data)}{ora(esempio) && <>, {ora(esempio)}</>}.
            </p>
          </div>
        </div>
        <div class="wrap"><Folio n={3} /></div>
      </section>
    )}

    <!-- Sommario: the contents page of the programme. -->
    <section class="pagina" aria-labelledby="sommario-t">
      <div class="wrap"><Testatina numero={cop.data.numero} /></div>
      <div class="wrap due">
        <div class="intro">
          <h2 id="sommario-t" class="display">Sommario</h2>
        </div>
        <ol class="sommario">
          {sommario.map((v) => (
            <li>
              <a class="voce leader" href={v.href}>
                <span class="voce-testo">
                  <span class="voce-titolo">{v.titolo}</span>
                  <span class="voce-nota">{v.testo}</span>
                </span>
                <span class="fill" aria-hidden="true"></span>
                <span class="typed pag" aria-hidden="true">{v.pagina}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="wrap"><Folio n={4} /></div>
    </section>
  </main>
</Base>

<style>
  /* ---------- Copertina ---------- */
  .copertina { position: relative; overflow: hidden; }
  .copertina-wrap {
    display: flex;
    flex-direction: column;
    min-height: min(100svh, 58rem);
  }
  .frontespizio {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-4);
  }
  h1 {
    display: grid;
    font-size: clamp(3.75rem, 2rem + 8.4vw, 9.5rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 0.84;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  h1 span:nth-child(2) { padding-left: 0.42em; }
  .logo {
    width: min(100%, 27rem);
    justify-self: end;
    margin-right: -1rem;
  }
  .locandina {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-3) var(--space-4);
    border-top: 1.5px solid var(--paper);
  }
  .dati { display: grid; gap: 0.2rem; }
  .quando {
    font-weight: 750;
    font-stretch: 78%;
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.05;
  }
  .dove { font-size: 1.125rem; }
  .nota { margin-top: 0.6rem; color: var(--paper-2); font-size: 0.9375rem; }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .link-sostieni {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    font-stretch: 88%;
  }

  /* ---------- Associazione ---------- */
  .associazione .display { font-size: clamp(2.5rem, 1.4rem + 3.6vw, 4.5rem); }
  .attivita { margin: 0; border-top: 1.5px solid var(--ink); }
  .voce-attivita {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 0.4rem 2rem;
    padding-block: 1.4rem 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .attivita dt {
    font-weight: 800;
    font-stretch: 75%;
    font-size: 1.5rem;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .attivita dd { margin: 0; max-width: var(--measure); }

  /* ---------- Serata ---------- */
  .serata .programma { padding-top: 0.4rem; }
  .didascalia { color: var(--ink-2); margin-top: 0.9rem; font-size: 0.875rem; }

  /* ---------- Sommario ---------- */
  .sommario { margin: 0; padding: 0; list-style: none; border-top: 1.5px solid var(--ink); }
  .sommario li { border-bottom: 1px solid var(--rule); }
  .voce {
    align-items: end;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 1.25rem;
    text-decoration: none;
    transition: background-color 0.25s var(--ease-out);
  }
  .voce-testo { display: grid; gap: 0.25rem; }
  .voce-titolo {
    font-weight: 750;
    font-stretch: 78%;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .voce-nota { color: var(--ink-2); }
  .voce .fill { margin-bottom: 0.5rem; transform: none; }
  .pag { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.6; }
  .voce:hover { background: rgb(2 14 126 / 0.05); }
  .voce:hover .voce-titolo { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.12em; }

  /* ---------- Responsive ---------- */
  @media (max-width: 40rem) {
    .frontespizio { grid-template-columns: 1fr; padding-block: var(--space-3) var(--space-3); }
    .logo { order: -1; width: 46vw; justify-self: end; margin: 0 -0.5rem -12vw 0; }
    h1 span:nth-child(2) { padding-left: 0.3em; }
    .locandina { padding-bottom: var(--space-3); }
    .azioni { width: 100%; }
    .voce-attivita { grid-template-columns: 1fr; }
    .voce .fill { display: none; }
    .voce { justify-content: space-between; }
  }
</style>
