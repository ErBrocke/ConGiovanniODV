---
import Base from '../layouts/Base.astro';
import Testata from '../components/Testata.astro';
import Biglietto from '../components/Biglietto.astro';
import Scaletta from '../components/Scaletta.astro';
import Foto from '../components/Foto.astro';
import Testatina from '../components/Testatina.astro';
import Folio from '../components/Folio.astro';
import {
  tutteLeEdizioni,
  inCopertina,
  romano,
  dataLunga,
  dataBreve,
  ora,
  anno,
  isoGiorno,
  EMAIL,
  IBAN,
  INSTAGRAM,
} from '../lib/edizioni';
import { eventoSchema } from '../lib/schema';

const edizioni = await tutteLeEdizioni();
const { edizione: cop, futura } = inCopertina(edizioni);
const daAnnunciare = futura && (!cop.data.ora || cop.data.premiati.length === 0);
// Last year's real running order shows what the evening is.
const esempio = edizioni.find((e) => e.data.programma.length > 0);
const site = Astro.site ?? new URL('https://congiovanniodv.pages.dev');
const segnala = `mailto:${EMAIL}?subject=${encodeURIComponent('Segnalazione per il Premio Giovanni Capanna')}`;
---
<Base
  title="Premio Giovanni Capanna · Con Giovanni ODV, Livorno"
  description={`Con Giovanni ODV ricorda Giovanni Capanna con il Premio per giovani artisti livornesi di musica e teatro. ${romano(cop.data.numero)} edizione: ${dataLunga(cop.data.data).toLowerCase()}, Auditorium del Conservatorio Mascagni, ingresso libero.`}
  jsonLd={[eventoSchema(cop, site)]}
  dono={false}
>
  <!-- Copertina: this year's programme. -->
  <div class="ink copertina">
    <div class="wrap copertina-wrap">
      <Testata presenta />

      <div class="frontespizio">
        <h1 id="titolo">
          <span>Premio</span>
          <span>Giovanni</span>
          <span>Capanna</span>
        </h1>
        <img
          class="logo"
          src="/logo-500.webp"
          width="500"
          height="500"
          alt="Logo di Con Giovanni ODV: Giovanni con gli occhiali da sole dentro un cerchio blu"
          fetchpriority="high"
        />
      </div>

      <div class="locandina">
        <div class="dati">
          <p class="quando">
            <time datetime={isoGiorno(cop.data.data)}>{dataLunga(cop.data.data)}</time>{ora(cop) && <>, {ora(cop)}</>}
          </p>
          <p class="dove">Auditorium del Conservatorio Mascagni, Livorno</p>
          <p class="typed nota">
            {romano(cop.data.numero)} edizione · ingresso libero{daAnnunciare && <> · orario e premiati saranno annunciati qui</>}
          </p>
        </div>
        <div class="azioni">
          {futura ? <Biglietto edizione={cop} /> : <a class="btn" href={`/premio/${anno(cop)}/`}>Com’è andata la {romano(cop.data.numero)} edizione</a>}
          <a class="link-sostieni" href="#sostieni">Sostieni il Premio</a>
        </div>
      </div>
    </div>
  </div>

  <main id="contenuto">
    <!-- La serata: a real running order, not a promise. -->
    {esempio && (
      <section class="pagina serata" aria-labelledby="serata-t">
        <div class="wrap"><Testatina numero={cop.data.numero} /></div>
        <div class="wrap due">
          <div class="intro">
            <h2 id="serata-t">Una serata di musica e teatro</h2>
            <p class="lead">Il Premio si consegna sul palco dell’Auditorium del Conservatorio Mascagni, davanti a chiunque voglia esserci. I premiati non ritirano soltanto: suonano e recitano.</p>
            <p><a href={`/premio/${anno(esempio)}/`}>La {romano(esempio.data.numero)} edizione, per intero</a></p>
          </div>
          <div class="programma">
            <Scaletta programma={esempio.data.programma} />
            <p class="typed didascalia">
              Programma della {romano(esempio.data.numero)} edizione, {dataBreve(esempio.data.data)}{ora(esempio) && <>, {ora(esempio)}</>}.
            </p>
          </div>
        </div>
        <div class="wrap"><Folio n={2} /></div>
      </section>
    )}

    <!-- Dedica: Giovanni. -->
    <section class="pagina dedica" id="giovanni" aria-labelledby="giovanni-t">
      <div class="wrap">
        <Testatina numero={cop.data.numero} />
        <div class="dedica-apertura">
          <Foto nome="giovanni-ritratto" class="ritratto" sizes="(min-width: 60rem) 34vw, 90vw" />
          <div class="dedica-testo">
            <h2 id="giovanni-t">A Giovanni</h2>
            <p>Giovanni Capanna era un imprenditore livornese, fondatore di Capanna People e Console di Svezia.</p>
            <p>Suonava, e faceva l’attore: si era formato con Gigi Proietti al Laboratorio di Esercitazioni Sceniche del Teatro Brancaccio di Roma. Era nello scoutismo Agesci fin da ragazzo. Amava Livorno e la sua famiglia, l’Inter e lo sci.</p>
            <p>Con Giovanni ODV porta avanti quello che gli stava a cuore: sostiene giovani talenti, promuove lo studio e le attività culturali, aiuta la ricerca sul tumore del pancreas metastatico e porta avanti iniziative di solidarietà.</p>
          </div>
        </div>

        <div class="album">
          <Foto nome="giovanni-in-scena" class="a-scena" didascalia="Giovanni in scena, da giovane." sizes="(min-width: 60rem) 56vw, 100vw" />
          <p class="a-frase">Chi lo conosceva ricorda soprattutto che faceva ridere, e che sapeva farlo anche di sé stesso.</p>
          <Foto nome="con-il-cane" class="a-cane" didascalia="All’aperto, con un border collie." sizes="(min-width: 60rem) 22vw, 50vw" />
          <Foto nome="intervento" class="a-intervento" didascalia="Durante un intervento." sizes="(min-width: 60rem) 40vw, 50vw" />
          <Foto nome="conversazione" class="a-conversazione" didascalia="Giovanni, al centro." sizes="(min-width: 60rem) 34vw, 100vw" />
          <Foto nome="consoli" class="a-consoli" didascalia="Giovanni è il quarto da sinistra." sizes="(min-width: 60rem) 66vw, 100vw" />
        </div>
        <Folio n={3} />
      </div>
    </section>

    <!-- Tavola fuori testo: a plate that bleeds off the trim into the ink insert. -->
    <figure class="tavola">
      <img
        src="/foto/in-scena-rosso-1600.webp"
        srcset="/foto/in-scena-rosso-800.webp 800w, /foto/in-scena-rosso-1600.webp 1600w, /foto/in-scena-rosso-2400.webp 2400w"
        sizes="100vw"
        width="1600"
        height="900"
        alt="Due attori in scena davanti a un sipario: un uomo in camicia bianca porge qualcosa a una donna in costume."
        loading="lazy"
        decoding="async"
      />
      <figcaption class="typed wrap">In scena.</figcaption>
    </figure>

    <!-- Inserto: the Premio and every edition, printed in ink. -->
    <div class="ink inserto">
      <div class="wrap"><Testatina numero={cop.data.numero} /></div>
      <section class="wrap premio" id="premio" aria-labelledby="premio-t">
        <h2 id="premio-t">Il Premio Giovanni Capanna</h2>
        <div class="premio-testo">
          <p class="lead">Dal 2023, ogni anno, un premio in denaro a giovani artisti livornesi di musica e teatro.</p>
          <p>La prima edizione si è tenuta il 3 dicembre 2023, a due anni dalla scomparsa di Giovanni. Da allora la serata torna ogni autunno all’Auditorium del Conservatorio Mascagni, con ingresso libero.</p>
          <p>Nel 2025 il Premio è stato riconosciuto nell’ambito della Festa della Toscana, bando del Consiglio regionale della Toscana.</p>
          <p>Conosci un giovane musicista o attore livornese che lo meriterebbe? <a href={segnala}>Scrivici</a>.</p>
        </div>
      </section>

      <section class="wrap edizioni" id="edizioni" aria-labelledby="edizioni-t">
        <h2 id="edizioni-t">Le edizioni</h2>
        <ol class="elenco">
          {edizioni.map((e) => (
            <li>
              <a class="riga" href={`/premio/${anno(e)}/`}>
                <span class="numero" aria-hidden="true">{romano(e.data.numero)}</span>
                <span class="sr-only">{romano(e.data.numero)} edizione,</span>
                <span class="data">
                  <time datetime={isoGiorno(e.data.data)}>{dataBreve(e.data.data)}</time>
                  <span class="typed">{e.data.ora ? ora(e) : 'orario da annunciare'}</span>
                </span>
                <span class="premiati">
                  {e.data.premiati.length > 0
                    ? e.data.premiati.map((p) => (
                        <span class="premiato">
                          {p.nome}
                          <span class="typed">{p.disciplina}</span>
                        </span>
                      ))
                    : <span class="premiato vuoto">Premiati da annunciare</span>}
                </span>
                <span class="vai" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
      <div class="wrap"><Folio n={4} /></div>
    </div>

    <!-- Sostieni: the back pages. -->
    <section class="pagina sostieni" id="sostieni" aria-labelledby="sostieni-t">
      <div class="wrap"><Testatina numero={cop.data.numero} /></div>
      <div class="wrap due">
        <div class="intro">
          <h2 id="sostieni-t">Come sostenerci</h2>
          <p class="lead">Le donazioni aiutano l’associazione a sostenere giovani artisti, la ricerca sul tumore del pancreas metastatico e le iniziative di solidarietà.</p>
        </div>
        <dl class="modi">
          <div class="modo">
            <dt>Bonifico</dt>
            <dd>
              <p>Intestato a <strong>Con Giovanni ODV</strong>.</p>
              <p class="iban num" id="iban">{IBAN}</p>
              <button class="btn copia" type="button" data-copia={IBAN} aria-controls="iban">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="8" y="8" width="12" height="12" /><path d="M16 8V4H4v12h4" /></svg>
                <span data-etichetta aria-live="polite">Copia IBAN</span>
              </button>
            </dd>
          </div>
          <div class="modo">
            <dt>Dai una mano</dt>
            <dd>
              <p>Se vuoi aiutare a organizzare la serata o le altre iniziative, scrivici.</p>
              <p><a class="contatto" href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            </dd>
          </div>
          <div class="modo">
            <dt>Seguici</dt>
            <dd>
              <p>Annunci, premiati e foto delle serate.</p>
              <p><a class="contatto" href={INSTAGRAM}>Instagram @con_giovanni</a></p>
            </dd>
          </div>
        </dl>
      </div>
      <div class="wrap"><Folio n={5} /></div>
    </section>
  </main>
</Base>

<style>
  /* ---------- Copertina ---------- */
  .copertina { position: relative; overflow: hidden; }
  .copertina-wrap {
    display: flex;
    flex-direction: column;
    min-height: min(100svh, 58rem);
  }
  .frontespizio {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-4);
  }
  h1 {
    display: grid;
    font-size: clamp(3.75rem, 2rem + 8.4vw, 9.5rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 0.84;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  h1 span:nth-child(2) { padding-left: 0.42em; }
  .logo {
    width: min(100%, 27rem);
    justify-self: end;
    margin-right: -1rem;
  }
  .locandina {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-3) var(--space-4);
    border-top: 1.5px solid var(--paper);
  }
  .dati { display: grid; gap: 0.2rem; }
  .quando {
    font-weight: 750;
    font-stretch: 78%;
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.05;
  }
  .dove { font-size: 1.125rem; }
  .nota { margin-top: 0.6rem; color: var(--paper-2); font-size: 0.9375rem; }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .link-sostieni {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    font-stretch: 88%;
  }

  /* ---------- Pagine ---------- */
  .pagina { padding-block: var(--space-3); }
  .due {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-4) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  h2 {
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.75rem);
    font-stretch: 66%;
    font-weight: 850;
    line-height: 0.88;
    text-transform: uppercase;
  }
  .lead {
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.45;
    font-stretch: 96%;
  }
  .intro { display: grid; gap: var(--space-3); max-width: var(--measure); }
  .intro h2 { margin-bottom: var(--space-1); }

  .serata .programma { padding-top: 0.4rem; }
  .didascalia { color: var(--ink-2); margin-top: 0.9rem; font-size: 0.875rem; }

  /* ---------- Dedica ---------- */
  .dedica-apertura {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-4) clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .dedica-testo { display: grid; gap: 1.1rem; max-width: var(--measure); padding-bottom: 0.25rem; }
  .dedica-testo h2 { font-size: clamp(3.5rem, 2rem + 4.6vw, 6rem); margin-bottom: var(--space-2); }

  .album {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4) clamp(1rem, 2.5vw, 2rem);
    margin-top: var(--space-6);
    align-items: start;
  }
  .album :global(.a-scena) { grid-column: 1 / span 7; }
  .a-frase {
    grid-column: 8 / span 5;
    align-self: center;
    font-weight: 800;
    font-stretch: 70%;
    font-size: clamp(1.75rem, 1.1rem + 2vw, 2.875rem);
    line-height: 1;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .album :global(.a-cane) { grid-column: 1 / span 3; align-self: end; }
  .album :global(.a-intervento) { grid-column: 4 / span 5; align-self: end; }
  .album :global(.a-conversazione) { grid-column: 9 / span 4; align-self: end; }
  .album :global(.a-consoli) { grid-column: 3 / span 8; }

  /* ---------- Tavola ---------- */
  .tavola { position: relative; margin: 0; background: var(--ink); }
  .tavola img { width: 100%; max-height: 88svh; object-fit: cover; }
  .tavola figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding-bottom: var(--space-3);
    color: var(--paper);
    font-size: 0.875rem;
  }

  /* ---------- Inserto in inchiostro ---------- */
  .inserto { padding-block: var(--space-3); }
  .premio {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-4) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .premio-testo { display: grid; gap: 1.1rem; max-width: var(--measure); }
  .premio-testo p:not(.lead) { color: var(--paper-2); }
  .premio-testo a { color: var(--paper); }

  .edizioni { margin-top: var(--space-6); }
  .premio { margin-top: 0; }
  .elenco { margin: var(--space-4) 0 0; padding: 0; list-style: none; border-top: 1.5px solid var(--paper); }
  .elenco li { border-bottom: 1px solid var(--rule-ink); }
  .riga {
    display: grid;
    grid-template-columns: 9rem 11rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.5rem clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.25rem;
    text-decoration: none;
    transition: background-color 0.25s var(--ease-out);
  }
  .numero {
    font-weight: 850;
    font-stretch: 62%;
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    line-height: 0.85;
  }
  .data { display: grid; font-weight: 650; font-stretch: 90%; }
  .data .typed { font-weight: 400; color: var(--paper-2); font-size: 0.875rem; }
  .premiati { display: flex; flex-wrap: wrap; gap: 0.35rem 1.75rem; }
  .premiato { font-weight: 650; font-stretch: 92%; font-size: 1.125rem; line-height: 1.25; }
  .premiato .typed { display: block; font-weight: 400; color: var(--paper-2); font-size: 0.875rem; }
  .premiato.vuoto { font-weight: 400; color: var(--paper-2); }
  .vai svg { width: 1.75rem; height: 1.75rem; transition: transform 0.35s var(--ease-out); }
  .riga:hover { background: rgb(242 243 241 / 0.06); }
  .riga:hover .vai svg { transform: translateX(0.35rem); }
  .riga:focus-visible { outline-offset: -2px; }

  /* ---------- Sostieni ---------- */
  .modi { margin: 0; border-top: 1.5px solid var(--ink); }
  .modo {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font-weight: 800;
    font-stretch: 75%;
    font-size: 1.5rem;
    line-height: 1.1;
    text-transform: uppercase;
  }
  dd { margin: 0; display: grid; gap: 0.6rem; justify-items: start; }
  .iban {
    font-weight: 650;
    font-stretch: 85%;
    font-size: clamp(1.25rem, 1rem + 1.3vw, 2rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .contatto { font-weight: 600; overflow-wrap: anywhere; }

  /* ---------- Responsive ---------- */
  @media (max-width: 60rem) {
    .due, .premio, .dedica-apertura { grid-template-columns: 1fr; }
    .dedica-apertura :global(.ritratto) { max-width: 26rem; }
    .riga { grid-template-columns: 5.5rem minmax(0, 1fr) 2rem; }
    .riga .premiati { grid-column: 2 / 3; }
    .riga .vai { grid-row: 1 / span 2; grid-column: 3; }
    .album { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .album :global(.a-scena) { grid-column: 1 / -1; }
    .a-frase { grid-column: 1 / -1; }
    .album :global(.a-cane) { grid-column: 1 / span 3; }
    .album :global(.a-intervento) { grid-column: 4 / span 3; }
    .album :global(.a-conversazione) { grid-column: 1 / -1; }
    .album :global(.a-consoli) { grid-column: 1 / -1; }
    .tavola img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 40rem) {
    .frontespizio { grid-template-columns: 1fr; padding-block: var(--space-3) var(--space-3); }
    .logo { order: -1; width: 46vw; justify-self: end; margin: 0 -0.5rem -12vw 0; }
    h1 span:nth-child(2) { padding-left: 0.3em; }
    .locandina { padding-bottom: var(--space-3); }
    .azioni { width: 100%; }
    .modo { grid-template-columns: 1fr; }
  }
</style>
