---
import Base from '../layouts/Base.astro';
import Frontespizio from '../components/Frontespizio.astro';
import Foto from '../components/Foto.astro';
import Testatina from '../components/Testatina.astro';
import Folio from '../components/Folio.astro';
import { tutteLeEdizioni, inCopertina } from '../lib/edizioni';

const { edizione: cop } = inCopertina(await tutteLeEdizioni());
---
<Base
  title="Giovanni Capanna · Con Giovanni ODV, Livorno"
  description="Giovanni Capanna era un imprenditore livornese, attore e musicista, fondatore di Capanna People. Con Giovanni ODV porta avanti quello che gli stava a cuore."
  image="/og.jpg"
>
  <Frontespizio titolo="A Giovanni" lead="Livornese, imprenditore, attore. Faceva ridere, anche di sé stesso." />

  <main id="contenuto">
    <section class="pagina dedica" aria-label="Chi era Giovanni">
      <div class="wrap">
        <Testatina numero={cop.data.numero} />
        <div class="dedica-apertura">
          <Foto nome="giovanni-ritratto" class="ritratto" sizes="(min-width: 60rem) 34vw, 90vw" eager />
          <div class="dedica-testo">
            <p>Giovanni Capanna era un imprenditore livornese, fondatore di Capanna People e Console di Svezia.</p>
            <p>Suonava, e faceva l’attore: si era formato con Gigi Proietti al Laboratorio di Esercitazioni Sceniche del Teatro Brancaccio di Roma. Era nello scoutismo Agesci fin da ragazzo. Amava Livorno e la sua famiglia, l’Inter e lo sci.</p>
            <p>Con Giovanni ODV porta avanti quello che gli stava a cuore: sostiene giovani talenti, promuove lo studio e le attività culturali, aiuta la ricerca sul tumore del pancreas metastatico e porta avanti iniziative di solidarietà.</p>
            <p><a href="/premio/">Il Premio Giovanni Capanna</a></p>
          </div>
        </div>

        <div class="album">
          <Foto nome="giovanni-in-scena" class="a-scena" didascalia="Giovanni in scena, da giovane." sizes="(min-width: 60rem) 56vw, 100vw" />
          <p class="a-frase">Chi lo conosceva ricorda soprattutto che faceva ridere, e che sapeva farlo anche di sé stesso.</p>
          <Foto nome="con-il-cane" class="a-cane" didascalia="All’aperto, con un border collie." sizes="(min-width: 60rem) 22vw, 50vw" />
          <Foto nome="intervento" class="a-intervento" didascalia="Durante un intervento." sizes="(min-width: 60rem) 40vw, 50vw" />
          <Foto nome="conversazione" class="a-conversazione" didascalia="Giovanni, al centro." sizes="(min-width: 60rem) 34vw, 100vw" />
          <Foto nome="consoli" class="a-consoli" didascalia="Giovanni è il quarto da sinistra." sizes="(min-width: 60rem) 66vw, 100vw" />
        </div>
        <Folio n={5} />
      </div>
    </section>

    <!-- Tavola fuori testo: a plate that bleeds off the trim into the back cover. -->
    <figure class="tavola">
      <img
        src="/foto/in-scena-rosso-1600.webp"
        srcset="/foto/in-scena-rosso-800.webp 800w, /foto/in-scena-rosso-1600.webp 1600w, /foto/in-scena-rosso-2400.webp 2400w"
        sizes="100vw"
        width="1600"
        height="900"
        alt="Due attori in scena davanti a un sipario: un uomo in camicia bianca porge qualcosa a una donna in costume."
        loading="lazy"
        decoding="async"
      />
      <figcaption class="typed wrap">In scena.</figcaption>
    </figure>
  </main>
</Base>

<style>
  .dedica-apertura {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-4) clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .dedica-testo { display: grid; gap: 1.1rem; max-width: var(--measure); padding-bottom: 0.25rem; }

  .album {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4) clamp(1rem, 2.5vw, 2rem);
    margin-top: var(--space-6);
    align-items: start;
  }
  .album :global(.a-scena) { grid-column: 1 / span 7; }
  .a-frase {
    grid-column: 8 / span 5;
    align-self: center;
    font-weight: 800;
    font-stretch: 70%;
    font-size: clamp(1.75rem, 1.1rem + 2vw, 2.875rem);
    line-height: 1;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .album :global(.a-cane) { grid-column: 1 / span 3; align-self: end; }
  .album :global(.a-intervento) { grid-column: 4 / span 5; align-self: end; }
  .album :global(.a-conversazione) { grid-column: 9 / span 4; align-self: end; }
  .album :global(.a-consoli) { grid-column: 3 / span 8; }

  .tavola { position: relative; margin: 0; background: var(--ink); }
  .tavola img { width: 100%; max-height: 88svh; object-fit: cover; }
  .tavola figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding-bottom: var(--space-3);
    color: var(--paper);
    font-size: 0.875rem;
  }

  @media (max-width: 60rem) {
    .dedica-apertura { grid-template-columns: 1fr; }
    .dedica-apertura :global(.ritratto) { max-width: 26rem; }
    .album { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .album :global(.a-scena), .a-frase, .album :global(.a-conversazione), .album :global(.a-consoli) { grid-column: 1 / -1; }
    .album :global(.a-cane) { grid-column: 1 / span 3; }
    .album :global(.a-intervento) { grid-column: 4 / span 3; }
    .tavola img { aspect-ratio: 4 / 3; }
  }
</style>
